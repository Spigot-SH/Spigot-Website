{
  "name": "spigot-website",
  "version": "1.0.0",
  "private": true,
  "license": "UNLICENSED",
  "description": "Spigot — Web UI and API marketplace",
  "scripts": {
    "dev": "next dev -p 5173",
    "build": "next build",
    "start": "next start -p ${PORT:-5173}",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "designsystem:llm": "node scripts/gen-designsystem-llm.mjs",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run build"
  },
  "dependencies": {
    "@stellar/freighter-api": "^6.0.1",
    "@stellar/stellar-sdk": "^16.2.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/qrcode": "^1.5.6",
    "lucide-react": "^1.31.0",
    "next": "^16.3.1",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.3.3",
    "viem": "^2.31.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^24.13.3",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.1",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.67.0"
  }
